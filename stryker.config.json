{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm --filter @mailuo/api test"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "mutate": ["apps/api/src/domain/**/*.ts", "apps/api/src/server.ts"],
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": {
    "fileName": "coverage/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "coverage/mutation/mutation.html"
  },
  "concurrency": 3,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "tempDirName": ".stryker-tmp",
  "logLevel": "info",
  "fileLogLevel": "debug"
}
