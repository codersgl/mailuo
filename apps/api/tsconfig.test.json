{
  // 测试代码的类型检查清单：`test/**` 与 `src/**` 一起进 tsc，否则改接口（字段改名、helper
  // 选项改名）只能靠运行期才发现，`typecheck` 会给假绿信号（见审计报告 D3）。
  // 单独一份的原因：主 tsconfig 带 `rootDir: "src"` 与 `outDir`，直接把它扩到 `test/**`
  // 会和产物布局打架；这份只做检查，`noEmit`。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  // vitest.config.ts 也一起检查：覆盖率的阈值与 include 写在里面，键名写错时 vitest 会在
  // 运行期报错，但那是跑到测试才发现的；放进 typecheck 清单能提前一档拦住。
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
