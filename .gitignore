node_modules/
dist/
build/

# 覆盖率报告产物（vitest 的 html reporter 输出到这里；变异测试的报告也落在这里）
coverage/

# Stryker 的沙箱/备份目录，只在本机跑变异测试时存在
.stryker-tmp/

# vitest runner 每起一个 worker 都会在 cwd 写一份 stryker-setup-<worker>.js，正常退出时会删掉，
# 被强杀或异常退出时残留。它纯属运行时产物，而且会跟着 apps/api 一起被 `git add -A` 收进来（D92 踩过）。
stryker-setup-*.js

# SQLite 数据文件不入版本库（见 docs/spec.md）
data/

# git worktree 工作目录，仅本地使用
.worktrees/

# 一次性的临时目录：原型、验收脚本、审阅用的库副本。它们可能落在仓库根或某个 worktree 里，
# 而 `git add -A` 会把这些数据库副本一起提交（D47 审阅时真的发生过一次），所以整类忽略。
.tmp-*/

*.log
.env
.env.*
.DS_Store

# 本机 pnpm store（沙箱里 HOME 下的默认 store 不可写，见 D42）
.pnpm-store/
