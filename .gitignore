node_modules/
dist/
build/

# SQLite 数据文件不入版本库（见 docs/spec.md）
data/

# git worktree 工作目录，仅本地使用
.worktrees/

# 一次性的临时目录：原型、验收脚本、审阅用的库副本。它们可能落在仓库根或某个 worktree 里，
# 而 `git add -A` 会把这些数据库副本一起提交（D47 审阅时真的发生过一次），所以整类忽略。
.tmp-*/

*.log
.env
.env.*
.DS_Store

# 本机 pnpm store（沙箱里 HOME 下的默认 store 不可写，见 D42）
.pnpm-store/
