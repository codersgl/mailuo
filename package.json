{
  "name": "@codersgl/mailuo",
  "version": "0.1.0",
  "description": "本地运行的个人任务看板：任务即看板，层级不限，数据存在本机的一个 SQLite 文件里",
  "keywords": [
    "kanban",
    "看板",
    "task",
    "todo",
    "任务管理",
    "sqlite",
    "local-first",
    "cli"
  ],
  "license": "AGPL-3.0-only",
  "author": "codersgl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codersgl/mailuo.git"
  },
  "homepage": "https://github.com/codersgl/mailuo#readme",
  "bugs": {
    "url": "https://github.com/codersgl/mailuo/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "bin": {
    "mailuo": "bin/mailuo.mjs"
  },
  "files": [
    "bin/mailuo.mjs",
    "apps/api/dist/",
    "apps/api/migrations/",
    "apps/web/dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @mailuo/api dev",
    "dev:web": "pnpm --filter @mailuo/web dev",
    "build": "pnpm -r build",
    "icons": "node scripts/build-icons.mjs",
    "lint": "eslint .",
    "start": "pnpm --filter @mailuo/api start",
    "prepack": "pnpm build",
    "test": "node --test bin/*.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
