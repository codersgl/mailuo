{
  "name": "mailuo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "codersgl",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mailuo": "bin/mailuo.mjs"
  },
  "files": [
    "bin/",
    "apps/api/dist/",
    "apps/api/migrations/",
    "apps/web/dist/",
    "README.md"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @mailuo/api dev",
    "dev:web": "pnpm --filter @mailuo/web dev",
    "build": "pnpm -r build",
    "icons": "node scripts/build-icons.mjs",
    "start": "pnpm --filter @mailuo/api start",
    "test": "node --test bin/*.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
