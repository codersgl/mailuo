{
  "name": "mailuo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "codersgl",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mailuo": "bin/mailuo.mjs"
  },
  "files": [
    "bin/mailuo.mjs",
    "apps/api/dist/",
    "apps/api/migrations/",
    "apps/web/dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @mailuo/api dev",
    "dev:web": "pnpm --filter @mailuo/web dev",
    "build": "pnpm -r build",
    "icons": "node scripts/build-icons.mjs",
    "start": "pnpm --filter @mailuo/api start",
    "prepack": "pnpm build",
    "test": "node --test bin/*.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  }
}
