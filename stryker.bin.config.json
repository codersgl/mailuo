{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test bin/*.test.mjs"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "mutate": [
    "bin/mailuo.mjs"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "coverage/mutation/bin.json"
  },
  "htmlReporter": {
    "fileName": "coverage/mutation/bin.html"
  },
  "concurrency": 1,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "tempDirName": ".stryker-tmp-bin",
  "logLevel": "info",
  "fileLogLevel": "debug"
}
